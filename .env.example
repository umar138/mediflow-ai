# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mediflow_db

# Security
JWT_SECRET_KEY=super-secret-hackathon-jwt-key-change-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Optional AI LLM Provider (Works with OpenAI-compatible APIs like Groq, OpenAI, OpenRouter, etc.)
# Agar key khali chhorenge tab bhi deterministic safety rules + smart fallback 100% kaam karega!
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_SECONDS=4.0

# Frontend Public API URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000